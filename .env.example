# OpenAI server-side secret. Never expose this with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Stage 1: screenshot -> structured conversation JSON
OPENAI_VISION_MODEL=gpt-5-mini

# Stage 2: FACT/metrics -> summary + AI friend response
# v0.3.6 default: faster/cheaper lightweight narrative model.
OPENAI_ANALYSIS_MODEL=gpt-5.4-nano

# Distributed cost/security guard for Vercel/public traffic.
# Strongly recommended before public rollout.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Set true after Upstash is configured. In this mode, analysis fails closed if the shared guard is unavailable.
USAGI_REQUIRE_DISTRIBUTED_GUARD=false

# Cost guard defaults. Tune after real usage measurement.
USAGI_IP_MINUTE_LIMIT=2
USAGI_IP_HOUR_LIMIT=5
USAGI_IP_DAILY_LIMIT=10
USAGI_GLOBAL_DAILY_LIMIT=100

# Recommended in production. Use a long random secret; never expose it to the client.
USAGI_SAFETY_SALT=
